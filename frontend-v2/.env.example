# Copy to .env.local and fill in real values.

# Google OAuth — required for /login.
# Create at https://console.cloud.google.com/apis/credentials
# Add http://localhost:5174 to "Authorized JavaScript origins" for dev.
VITE_GOOGLE_CLIENT_ID=

# Allowed login domain. Logins from any other domain are rejected.
VITE_ALLOWED_DOMAIN=vedantu.com

# Backend API base.
# Default → Railway production backend (Phase 1 architecture:
# Celery + Redis + Volume + watchdog).
# Override in .env.local with `VITE_API_BASE=http://localhost:8000`
# to test against a local inline backend.
VITE_API_BASE=https://cmds-book-production.up.railway.app
