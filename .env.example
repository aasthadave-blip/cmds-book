# ── Gemini ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_REGEN_MODEL=gemini-2.5-pro

# ── Claude / Anthropic (optional) ───────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5

# ── Task Executor ────────────────────────────────────────
# "celery" = prod (requires Redis, separate worker process)
# "inline" = local dev without Docker (tasks run inside uvicorn, restart = jobs lost)
TASK_EXECUTOR=celery

# ── Database ────────────────────────────────────────────
# Prod (docker-compose):
DATABASE_URL=postgresql+asyncpg://cmds:cmds@postgres:5432/cmds
SYNC_DATABASE_URL=postgresql+psycopg2://cmds:cmds@postgres:5432/cmds
# Local dev (no Docker): uncomment these and comment out the lines above
# DATABASE_URL=sqlite+aiosqlite:///./cmds.db
# SYNC_DATABASE_URL=sqlite:///./cmds.db

# ── Redis / Celery ──────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Storage ──────────────────────────────────────────────
# "s3" = prod/docker (MinIO or AWS S3)
# "local" = local dev without Docker
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_PDFS=cmds-pdfs
S3_BUCKET_EXPORTS=cmds-exports
S3_BUCKET_OCR_UPLOADS=cmds-ocr-uploads

# ── App ─────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Multi-OCR (optional) ─────────────────────────────────
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
SARVAM_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
